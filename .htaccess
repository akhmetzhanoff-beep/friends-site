AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk
AddType video/mp4 .mp4
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Old Tilda pages -> home page (keeps old links and search positions).
RewriteRule ^page(01|02|60153321|155348503|155349083|164703303|166047403)(\.html)?$ / [L,R=301]
# Short links of pages the stores ask for.
RewriteRule ^(privacy|support|delete-account)/?$ $1.html [L]
# Blogger links like /kappas open the landing (it reads the code from the path).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[A-Za-z0-9_-]+/?$ index.html [L]
RewriteRule ^\.leads/ - [F]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "(sw\.js|\.html|manifest\.webmanifest|version\.txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
